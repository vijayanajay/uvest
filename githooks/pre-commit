#!/bin/sh
# UVEST pre-commit hook — runs the full invariant & gate suite, then the
# behavioral evals scorecard against the frozen baseline.
#
# Tracked in githooks/ and activated via `git config core.hooksPath githooks`
# (run scripts/setup_hooks.sh once per clone). Failing either blocks the
# commit, treating spec drift like a build failure — capital-risk invariants
# and eval-gate regressions must never ship on a broken baseline.
#
# The scorecard half is BASELINE-AWARE (`run_evals.py --regression-exit`):
# gates 4/5 are red by policy — published numbers, not defects — so demanding
# an absolute SUITE PASSED made every commit need `--no-verify`, which caught
# nothing at all. What blocks now is a *regression against the frozen
# baseline's `gates` block*: a PASS that stops passing, grading that disappears,
# a banked red that gets worse, or a red nobody deliberately banked. Publishing
# a changed scorecard (a new red, or an improvement worth recording) is the
# deliberate act: `python tests/run_evals.py --re-freeze-gates`.
# Non-gate failures — dataset integrity, probe rosters, evidence coverage,
# the rule census — still block absolutely, in every mode.

# Anchor to the repo root, wherever git invokes us from, so `python tests/...`
# paths resolve correctly under submodules, worktrees, and unusual cwd.
REPO_ROOT=$(git rev-parse --show-toplevel) || exit 1
cd "$REPO_ROOT" || exit 1

# Prefer the repository's own interpreter over whatever `python` is first on
# PATH: the suite imports the pinned requirements (fastdtw, lightgbm), which a
# system interpreter may not have, so a green tree could fail here — or a red
# one pass — purely because a shell picked another runtime. CI pins its own
# 3.11 via setup-python; this is the same pin, locally.
if [ -x "$REPO_ROOT/.venv/Scripts/python.exe" ]; then
    PY="$REPO_ROOT/.venv/Scripts/python.exe"        # Windows
elif [ -x "$REPO_ROOT/.venv/bin/python" ]; then
    PY="$REPO_ROOT/.venv/bin/python"                # POSIX
else
    PY="python"
fi
echo "   (interpreter: $PY)"

echo "🛡️  UVEST invariant suite (pre-commit)..."
"$PY" tests/run_all_tests.py
status=$?

if [ $status -ne 0 ]; then
    echo ""
    echo "❌ Pre-commit blocked: invariant suite FAILED (exit $status)."
    echo "   Capital-risk gates must pass before committing."
    echo "   Bypass deliberately with: git commit --no-verify"
    exit $status
fi
echo "✅ Invariant suite passed."

echo ""
echo "📊 UVEST behavioral evals scorecard (pre-commit, baseline-aware)..."
"$PY" tests/run_evals.py --regression-exit
evals_status=$?

if [ $evals_status -ne 0 ]; then
    echo ""
    echo "❌ Pre-commit blocked: eval regression against the frozen baseline (exit $evals_status)."
    echo "   Banked reds pass; a lost PASS, lost grading, a worse red, or an"
    echo "   unbanked red blocks. Publish a deliberate change with:"
    echo "     python tests/run_evals.py --re-freeze-gates"
    echo "   Bypass deliberately with: git commit --no-verify"
    exit $evals_status
fi
echo "✅ Evals scorecard: no regression vs the frozen baseline (banked reds tolerated)."

exit 0
