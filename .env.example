# Dhan API credentials — the operator-gated Tier-2 half of stage 8
# (scripts/8_dhan_precision.py, BRD §8.1).
#
# Copy this file to `.env` (gitignored) and fill in your own values. These
# two variables are the ONLY thing the live half needs; without them stage 8
# waives the Dhan half (`waived: true`, `spread_impact_cost_pct: null`,
# `waived_reason` naming the cause) and still ships the daily Tier-1 zone,
# exiting 0. The validation chain never passes `--live`, so no recorded
# artifact ever depends on these being set.
#
# A token is never committed: not in `.env`, not in a fixture, not in a
# provenance block, not in a log line. 24-hour token lifetime (docs 2026-10-16).
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
